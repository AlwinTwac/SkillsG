rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isCompany() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'company';
    }

    function isStudent() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }

    function isRecruiter() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'recruiter';
    }

    match /achievements/{achievementId} {
      // Public read for approved achievements
      allow read: if resource.data.status == 'approved';
      
      // Dashboard listing
      allow list: if isStudent() || isCompany();
      
      // Student creation rules
      allow create: if isStudent() &&
                    request.resource.data.studentUid == request.auth.uid &&
                    request.resource.data.description is string &&
                    request.resource.data.description.size() > 0 &&
                    request.resource.data.description.size() < 1000 &&
                    request.resource.data.status == 'pending';
      
      // Student updates
      allow update: if isStudent() &&
                    request.auth.uid == resource.data.studentUid &&
                    resource.data.status == 'pending' &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['description']);
      
      // Company approval/rejection
      allow update: if isCompany() &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
                    request.resource.data.status in ['approved', 'rejected'];
      
      // Featured content management
      allow update: if isCompany() &&
                    resource.data.status == 'approved' &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isFeatured', 'companyApprover']) &&
                    (!('isFeatured' in request.resource.data) || request.resource.data.isFeatured is bool) &&
                    (!('companyApprover' in request.resource.data) || request.resource.data.companyApprover == request.auth.uid);
    }

    match /users/{userId} {
      // Read permissions
      allow read: if (
        resource.data.profileVisibility == 'public' ||
        (request.auth != null && request.auth.uid == userId) ||
        (isCompany() && resource.data.role == 'student' && resource.data.companyUid == request.auth.uid) ||
        resource.data.role == 'company'
      );
      
      // Listing permissions
      allow list: if isRecruiter() || isCompany();
      
      // Modification permissions
      allow create, delete: if request.auth != null && request.auth.uid == userId;
      allow update: if 
        (request.auth != null && request.auth.uid == userId) ||
        (isCompany() && 
         resource.data.role == 'student' && 
         ((resource.data.companyUid == request.auth.uid &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrolledCourseIds'])) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['companyUid', 'enrolledCourseIds']) &&
           request.resource.data.companyUid == request.auth.uid)));
    }

    match /platformConfig/singleton {
      allow read: if true;
      allow create: if request.resource.data.companyAccountCreated == true && isCompany();
      allow write, delete: if false;
    }

    match /courses/{courseId} {
      allow read: if request.auth != null && (
        resource.data.companyUid == request.auth.uid ||
        (isStudent() && resource.id in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enrolledCourseIds)
      );
      allow create, update, delete: if isCompany() && resource.data.companyUid == request.auth.uid;
    }

    match /learningContent/{contentId} {
      allow read: if request.auth != null && (
        resource.data.companyUid == request.auth.uid ||
        (isStudent() && resource.data.courseId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enrolledCourseIds)
      );
      allow create, update, delete: if isCompany() && resource.data.companyUid == request.auth.uid;
    }

    match /tutorials/{tutorialId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.studentUid ||
        get(/databases/$(database)/documents/users/$(resource.data.studentUid)).data.profileVisibility == 'public'
      );
      allow list: if isStudent();
      allow create: if request.auth != null && request.resource.data.studentUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.studentUid == request.auth.uid;
    }

    match /interviewReports/{reportId} {
      allow read, create, update, delete: if request.auth != null &&
        (request.auth.uid == resource.data.companyUid ||
         request.auth.uid == resource.data.studentUid);
    }

    match /pendingInterviewReports/{reportId} {
      allow create: if request.auth != null && request.resource.data.studentUid == request.auth.uid;
      allow read, update, delete: if isCompany();
    }

    match /enrollments/{enrollmentId} {
      // Creation with validation - allow companies to enroll students not yet linked to them
      allow create: if 
        isCompany() && 
        request.resource.data.companyUid == request.auth.uid &&
        request.resource.data.studentUid != null &&
        request.resource.data.courseId != null &&
        get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.companyUid == request.auth.uid;
      
      // Status updates only
      allow update: if 
        isCompany() && 
        resource.data.companyUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status in ['active', 'completed', 'dropped'];
      
      // Deletion by owner
      allow delete: if isCompany() && resource.data.companyUid == request.auth.uid;
      
      // Read permissions
      allow read, list: if 
        (isCompany() && resource.data.companyUid == request.auth.uid) ||
        (isStudent() && resource.data.studentUid == request.auth.uid);
    }

    match /certificates/{certificateId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.studentUid ||
        request.auth.uid == resource.data.companyUid ||
        get(/databases/$(database)/documents/users/$(resource.data.studentUid)).data.profileVisibility == 'public'
      );
      allow list: if isStudent();
      allow create, update, delete: if isCompany() && request.resource.data.companyUid == request.auth.uid;
    }

    match /attendance/{attendanceId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.studentUid ||
        request.auth.uid == resource.data.companyUid
      );
      // Granular write permissions
      allow create, update: if 
        isCompany() && 
        request.auth.uid == request.resource.data.companyUid &&
        request.resource.data.studentUid != null &&
        request.resource.data.date != null &&
        request.resource.data.status in ['Present', 'Absent', 'Late'];
      allow delete: if false; // Disallow deletions
    }

    match /hollacaller/{callerId} {
      // Read permissions for companies
      allow read, list: if isCompany();
      
      // Create: Only companies can create entries, must have valid data
      allow create: if 
        isCompany() &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 &&
        request.resource.data.Name is string &&
        request.resource.data.Name.size() > 0;
      
      // Update: Only companies can update
      allow update: if isCompany();
      
      // Delete: Only companies can delete
      allow delete: if isCompany();
    }
  }
}