rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if (
        resource.data.profileVisibility == 'public' ||
        (request.auth != null && request.auth.uid == userId) ||
        (request.auth != null && resource.data.role == 'student' && resource.data.companyUid == request.auth.uid) ||
        resource.data.role == 'company' ||
        (request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'company' && resource.data.role == 'student' && resource.data.profileCompleted == true)
      );
      
      allow create: if request.auth != null && (
        request.resource.data.role != 'company' ||
        !exists(/databases/$(database)/documents/platformConfig/singleton)
      );
      
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'company' && get(/databases/$(database)/documents/users/$(userId)).data.role == 'student')
      );
      
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // --- Singleton Config Collection ---
    match /platformConfig/singleton {
      allow read: if true;
      allow create: if request.resource.data.companyAccountCreated == true;
      allow write, delete: if false;
    }

    // --- Courses Collection ---
    match /courses/{courseId} {
      allow read: if request.auth != null && (
        resource.data.companyUid == request.auth.uid ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student' &&
          resource.id in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enrolledCourseIds
        )
      );
      allow create, update, delete: if request.auth != null && request.resource.data.companyUid == request.auth.uid;
    }

    // --- Learning Content Collection ---
    match /learningContent/{contentId} {
      allow read: if request.auth != null && (
        resource.data.companyUid == request.auth.uid ||
        (
          resource.data.courseId != null &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student' &&
          resource.data.courseId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enrolledCourseIds
        )
      );
      allow create, update, delete: if request.auth != null && request.resource.data.companyUid == request.auth.uid;
    }

    // --- Enrollments Collection ---
    match /enrollments/{enrollmentId} {
      // Create/Update uses request.resource.data which refers to the incoming document
      allow create, update: if request.auth != null && request.resource.data.companyUid == request.auth.uid;
      // Delete must use resource.data which refers to the existing document in the database
      allow delete: if request.auth != null && resource.data.companyUid == request.auth.uid;
      
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.studentUid || 
        request.auth.uid == resource.data.companyUid
      );
    }

    // --- Tutorials Collection ---
    match /tutorials/{tutorialId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.studentUid ||
        get(/databases/$(database)/documents/users/$(resource.data.studentUid)).data.profileVisibility == 'public'
      );
      allow create, update, delete: if request.auth != null && request.auth.uid == resource.data.studentUid;
    }

    // --- Interview Reports Collection ---
    match /interviewReports/{reportId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.companyUid || request.auth.uid == resource.data.studentUid);
      allow create: if request.auth != null && request.resource.data.studentUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.companyUid == request.auth.uid;
    }

    // --- Certificates Collection ---
    match /certificates/{certificateId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.studentUid || 
        request.auth.uid == resource.data.companyUid ||
        get(/databases/$(database)/documents/users/$(resource.data.studentUid)).data.profileVisibility == 'public'
      );
      allow create, update, delete: if request.auth != null && request.resource.data.companyUid == request.auth.uid;
    }

    // --- Attendance Collection ---
    match /attendance/{attendanceId} {
      allow read: if request.auth != null && (
          request.auth.uid == resource.data.studentUid ||
          request.auth.uid == resource.data.companyUid
      );
      allow write: if request.auth != null && request.auth.uid == request.resource.data.companyUid;
    }
  }
}
